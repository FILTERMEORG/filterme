{
  "manifest_version": 3,
  "name": "FILTERME - 필터미",
  "version": "1.0.2",
  "description": "YouTube 라이브 채팅에서 욕설·성적·정치·도배 채팅을 AI로 걸러내고, 외국어 채팅을 실시간 번역합니다. AI가 방송 내용도 요약해줘요.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "FILTERME 전체 필터 설정",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://filterme.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/live_chat*",
        "https://www.youtube.com/live_chat_replay*"
      ],
      "all_frames": true,
      "js": ["fm-core.js", "fm-i18n.js", "fm-filter.js", "fm-translate.js", "fm-manager.js", "fm-socket.js", "fm-ui.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "popup.js",
        "popup.css",
        "fm-i18n.js",
        "icons/platforms/youtube.png",
        "icons/platforms/chzzk.png",
        "icons/platforms/soop.png"
      ],
      "matches": ["https://www.youtube.com/*"]
    }
  ]
}

