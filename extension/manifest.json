{
    "manifest_version": 3,
    "name": "FilterMe",
    "version": "0.1.0",
    "description": "YouTube 라이브 채팅 AI 필터",
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": ["*://www.youtube.com/*"],
            "all_frames": true,
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}